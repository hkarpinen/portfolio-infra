worker_processes auto;
events {
    worker_connections 1024;
}

# The dev and e2e edge. Same job as the production nginx — put the frontend and the API on one
# origin — without TLS, ACME or the upload volumes. It carries no route table either: `/api` goes
# to the gateway, which is the only place that knows what a service is.
#
# Both upstreams come from env so the same file serves both callers: dev points the frontend at
# `npm run dev` on :3000, the e2e suite points it at the standalone build on :3100.
http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    client_max_body_size 25M;

    upstream gateway_upstream  { server ${GATEWAY_UPSTREAM}; }
    upstream frontend_upstream { server ${FRONTEND_UPSTREAM}; }

    server {
        listen 8080;

        # Written without a trailing slash on purpose: with one, a request for exactly
        # /api/households is answered with a 301 rather than proxied, and the app calls that path.
        location /api {
            proxy_pass http://gateway_upstream;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /api/notifications/stream {
            proxy_pass http://gateway_upstream;
            proxy_set_header Host $host;
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 90s;
        }

        location / {
            proxy_pass http://frontend_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade    $http_upgrade;
            proxy_set_header Connection "upgrade";
            # $http_host, NOT $host: $host drops the port. Next validates a Server Action's Origin
            # against its Host, so "localhost:8090" vs "localhost" fails every action with
            # "Invalid Server Actions request." — which is every household created through the UI.
            proxy_set_header Host       $http_host;
        }
    }
}
