worker_processes auto;
events {
    worker_connections 1024;
}

# The edge, and only the edge: TLS, ACME, the upload volumes, and two upstreams. It knows the
# single prefix `/api`, not seven service names — the route table lives in gateway/, which is a
# project rather than a config file because it is the system's public API contract and has more
# than one client.
http {
    include       mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;
    client_max_body_size 25M;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/javascript application/x-javascript text/xml application/xml application/rss+xml;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;

    # Per-client-IP limiting, which is the thing the services cannot do: their AddRateLimiter
    # policies are unpartitioned, so those are global buckets. These two are per address.
    limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=10r/m;
    limit_req_zone $binary_remote_addr zone=api_limit:10m rate=200r/m;
    limit_req_status 429;

    upstream gateway_upstream {
        server ${GATEWAY_UPSTREAM};
        keepalive 32;
    }

    upstream frontend_upstream {
        server ${FRONTEND_UPSTREAM};
        keepalive 16;
    }

    # HTTP → HTTPS
    server {
        listen 80;
        server_name hankkarpinen.com www.hankkarpinen.com;

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 308 https://hankkarpinen.com$request_uri;
        }
    }

    # HTTPS: redirect www → non-www
    server {
        listen 443 ssl http2;
        server_name www.hankkarpinen.com;

        ssl_certificate     /etc/letsencrypt/live/hankkarpinen.com/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/hankkarpinen.com/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers on;
        ssl_session_cache   shared:SSL:10m;
        ssl_session_timeout 10m;

        return 308 https://hankkarpinen.com$request_uri;
    }

    server {
        listen 443 ssl http2;
        server_name hankkarpinen.com;

        ssl_certificate     /etc/letsencrypt/live/hankkarpinen.com/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/hankkarpinen.com/privkey.pem;
        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers on;
        ssl_session_cache   shared:SSL:10m;
        ssl_session_timeout 10m;

        # Security headers
        # CSP allows: inline scripts (Next.js hydration), Google reCAPTCHA v3 scripts/frames,
        # any image origin (user-controlled avatar URLs + OpenWeatherMap + OSM tiles via Leaflet).
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline'; img-src * data: blob:; connect-src 'self' https://www.google.com; frame-src https://www.google.com; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none';" always;
        add_header X-Content-Type-Options  "nosniff" always;
        add_header X-Frame-Options         "DENY" always;
        add_header Referrer-Policy         "strict-origin-when-cross-origin" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

        location /uploads/avatars/ {
            alias /var/www/avatars/;
            add_header Cache-Control        "public, max-age=3600";
            add_header Content-Disposition  "inline";
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options      "SAMEORIGIN" always;
            try_files $uri =404;
        }

        location /uploads/forum/ {
            alias /var/www/forum/;
            add_header Cache-Control        "public, max-age=3600";
            add_header Content-Disposition  "inline";
            add_header X-Content-Type-Options "nosniff" always;
            add_header X-Frame-Options      "SAMEORIGIN" always;
            try_files $uri =404;
        }

        # Server-sent events. YARP streams responses without buffering, but nginx buffers by
        # default and would hold the stream here. Exact-match, because this is the only SSE
        # endpoint that exists — the old config also special-cased /api/forum/.+/events, which
        # no forum controller has ever served.
        location = /api/notifications/stream {
            proxy_pass http://gateway_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_buffering off;
            proxy_cache off;
            proxy_read_timeout 90s;
            proxy_send_timeout 90s;
        }

        # Tighter per-IP limit on the auth surface than on the rest of the API.
        location /api/identity {
            limit_req zone=auth_limit burst=5 nodelay;

            proxy_pass http://gateway_upstream;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location /api {
            limit_req zone=api_limit burst=20 nodelay;

            proxy_pass http://gateway_upstream;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Everything else goes straight to Next, not through the gateway: pages, assets and the
        # HMR socket have no business taking a hop through .NET.
        location / {
            proxy_pass http://frontend_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_cache_bypass $http_upgrade;
        }
    }
}
